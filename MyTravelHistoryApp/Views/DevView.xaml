<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MyTravelHistoryApp.Views.DevView"
             Title="DevView">
    <VerticalStackLayout>
        <Button Text="Reset database"
                Command="{Binding ResetDatabaseCommand}"
                HeightRequest="50"/>
        <Label Text="locationManager PausesLocationUpdatesAutomatically"
                HeightRequest="50"/>
        <Switch IsToggled="{Binding PausesLocationUpdatesAutomaticallyIsToggled}"                
                HeightRequest="50"/>
    </VerticalStackLayout>
</ContentPage>